{
  "$schema": "https://raw.githubusercontent.com/e-stpierre/skills/main/plugins/esp-skills/references/config.schema.json",
  "version": 1,
  "defaults": {
    "interactive": "off",
    "language": "en-US",
    "models": {
      "planner": { "model": "opus", "effort": "high" },
      "explorer": { "model": "sonnet" },
      "builder": {
        "low": { "model": "sonnet" },
        "medium": { "model": "opus" },
        "high": { "model": "opus", "effort": "high" }
      },
      "verifier": { "model": "sonnet" },
      "reviewer": { "model": "opus", "effort": "high" },
      "fixer": { "model": "opus" },
      "mechanical": { "model": "haiku" }
    }
  },
  "runs": { "root": "~/.esp-skills/runs", "retention_days": 90 },
  "worktrees": { "root": "~/.esp-skills/worktrees", "cleanup": "on-merge" },
  "branch": {
    "pattern": "{category}/{issue}_{name}",
    "pattern_without_issue": "{category}/{name}",
    "default_category": "feature",
    "categories": ["feature", "fix", "chore", "doc", "refactor", "poc"]
  },
  "commit": {
    "style": "plain",
    "co_author": true,
    "plan_step_prefix": true,
    "review_fixes": "separate"
  },
  "pr": {
    "base": null,
    "draft": false,
    "attribution": true,
    "body_from_run": true,
    "body_sections": [
      "summary",
      "milestones",
      "decisions",
      "review-resolution",
      "follow-ups"
    ]
  },
  "analyze": { "output_dir": "analysis" },
  "plan": {
    "default_type": "auto",
    "explore_agents": { "feature": 3, "bug": 2, "chore": 2 }
  },
  "review": {
    "dimensions": [
      "correctness",
      "security",
      "conventions",
      "plan-conformance"
    ],
    "min_severity": "medium",
    "verify_findings": true
  },
  "fix-review": {
    "max_rounds": 3,
    "fix_ci": true,
    "reply_to_rejected": true,
    "deferred_items": "follow-up",
    "wait": {
      "reviewers": {
        "claude": { "login": "claude[bot]", "trigger": null },
        "codex": {
          "login": "chatgpt-codex-connector[bot]",
          "trigger": "@codex review"
        }
      },
      "default_reviewers": ["claude"],
      "timeout_minutes": 30,
      "poll_seconds": 60,
      "auto_trigger": false,
      "checks_grace_seconds": 120
    }
  },
  "merge": {
    "enabled": true,
    "method": "repo",
    "preference": ["squash", "rebase", "merge"],
    "delete_branch": true,
    "require_resolved_threads": true,
    "require_green_checks": true,
    "use_auto_merge": false,
    "checks_timeout_minutes": 30
  },
  "ship": {
    "plan_mode": "auto",
    "review_mode": "auto",
    "auto": { "review_max_files": 3, "review_max_lines": 150 },
    "review": {
      "always_paths": [
        "**/auth/**",
        "**/security/**",
        "**/migrations/**",
        ".github/workflows/**",
        ".gitlab-ci.yml",
        "**/Jenkinsfile"
      ]
    },
    "internal_review_rounds": 2,
    "worktree": false,
    "dirty_tree": "worktree",
    "pr_draft_until_reviewed": true,
    "halt_on": [
      "critical-security",
      "gates-exhausted",
      "scope-change",
      "destructive-action",
      "budget"
    ],
    "inline": { "max_files_changed": 10, "escalate": true },
    "budgets": {
      "inline": { "max_wall_minutes": 60 },
      "orchestrated": { "max_wall_minutes": 240, "max_milestones": 12 }
    },
    "max_retries_per_milestone": 2,
    "parallel": "auto",
    "max_parallel": 3,
    "commit_per_milestone": true,
    "gates_scope": "milestone",
    "gates": {
      "test": null,
      "lint": null,
      "typecheck": null,
      "build": null,
      "always": []
    },
    "reuse": {
      "limit_tokens": 250000,
      "cost": { "low": 40000, "medium": 70000, "high": 120000 }
    }
  },
  "recap": {
    "roots": ["~/.esp-skills/runs"],
    "default_range_days": 7,
    "fan_out_threshold": 5
  }
}
